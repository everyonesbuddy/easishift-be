# Copy to config.env and fill in. See README for what each one does.
DB_URL=mongodb://127.0.0.1:27017/wisershifts
JWT_SECRET=change-me
STAFF_LINK_KEY=
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:5173
PORT=5000
NODE_ENV=development
DEFAULT_COUNTRY_CODE=+1

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_FACILITY_MONTHLY=
STRIPE_PRICE_FACILITY_YEARLY=
STRIPE_FOUNDING_COUPON_ID=

POSTMARK_API_TOKEN=
POSTMARK_SENDER_EMAIL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=

ANTHROPIC_API_KEY=

# ── HQ command center (WiserShifts' own team) ─────────────────────────────
# HQ has its own accounts: create them with `node scripts/create-hq-user.js <email> "<name>"`.
# Optional: a separate signing secret for HQ sessions (defaults to JWT_SECRET).
HQ_JWT_SECRET=
# TODO(keys): Klaviyo private API key + newsletter list id (calculator opt-ins join it)
KLAVIYO_PRIVATE_KEY=
KLAVIYO_LIST_ID=
# TODO(keys): Google service account JSON (one line) + GA4 property id + Search Console site
GOOGLE_SERVICE_ACCOUNT_JSON=
GA4_PROPERTY_ID=
GSC_SITE_URL=
# TODO(keys): YouTube Data API key + channel id (UC…)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# TODO(keys): Contentful space + Content Delivery API token
CONTENTFUL_SPACE_ID=
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_ENVIRONMENT=master
# The blog content type's ID in Contentful (default blogPost)
CONTENTFUL_CONTENT_TYPE=
